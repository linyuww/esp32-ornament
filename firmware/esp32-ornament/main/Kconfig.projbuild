menu "Codex Ornament"

config ORNAMENT_WIFI_SSID
    string "Wi-Fi SSID"
    default ""

config ORNAMENT_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config ORNAMENT_BRIDGE_URL
    string "Bridge state URL"
    default "http://192.168.1.100:8787/state"

config ORNAMENT_CONNECT_TIMEOUT_MS
    int "Wi-Fi connect timeout in milliseconds"
    default 60000
    range 5000 120000

config ORNAMENT_PROV_AP_PREFIX
    string "Provisioning SoftAP SSID prefix"
    default "Codex-Ornament"

config ORNAMENT_PROV_AP_PASSWORD
    string "Provisioning SoftAP password"
    default "codex1234"
    help
        Use at least 8 characters. Set empty for an open provisioning AP.

config ORNAMENT_PROV_AP_CHANNEL
    int "Provisioning SoftAP channel"
    default 1
    range 1 13

config ORNAMENT_PROV_SCAN_MAX
    int "Maximum Wi-Fi networks shown in provisioning portal"
    default 16
    range 4 32

config ORNAMENT_HOSTNAME_PREFIX
    string "Network hostname prefix"
    default "codex-ornament"
    help
        The firmware appends the last two STA MAC bytes, for example
        codex-ornament-4ad4.local.

config ORNAMENT_MDNS_ENABLED
    bool "Advertise local web console with mDNS"
    default y

config ORNAMENT_POLL_INTERVAL_MS
    int "Bridge poll interval in milliseconds"
    default 3000
    range 1000 60000

config ORNAMENT_UI_FRAME_MS
    int "Animated UI frame interval in milliseconds"
    default 250
    range 100 2000

config ORNAMENT_SNTP_SERVER
    string "SNTP server"
    default "pool.ntp.org"

config ORNAMENT_TIMEZONE
    string "POSIX timezone"
    default "CST-8"
    help
        POSIX timezone string used by localtime_r(). CST-8 means UTC+8.

config ORNAMENT_QUOTA_CRITICAL_PERCENT
    int "Critical quota percent"
    default 10
    range 0 100

config ORNAMENT_QUOTA_WARN_PERCENT
    int "Warning quota percent"
    default 25
    range 0 100

config ORNAMENT_DONE_FLASH_MS
    int "Task done ring flash duration in milliseconds"
    default 10000
    range 0 600000

menu "ASRPRO done reminder"

config ORNAMENT_ASRPRO_DONE_NOTIFY
    bool "Notify ASRPRO when task status becomes done"
    default y
    help
        When the bridge status enters done, send a UART trigger to ASRPRO.
        Configure the ASRPRO project to receive the trigger string and play
        the chosen audio file. Other task statuses are not announced.

config ORNAMENT_ASRPRO_UART_NUM
    int "ASRPRO UART port"
    depends on ORNAMENT_ASRPRO_DONE_NOTIFY
    default 1
    range 0 2

config ORNAMENT_ASRPRO_UART_BAUD
    int "ASRPRO UART baud rate"
    depends on ORNAMENT_ASRPRO_DONE_NOTIFY
    default 9600
    range 1200 921600

config ORNAMENT_ASRPRO_UART_TX_GPIO
    int "ESP32 TX GPIO to ASRPRO RX"
    depends on ORNAMENT_ASRPRO_DONE_NOTIFY
    default 17

config ORNAMENT_ASRPRO_UART_RX_GPIO
    int "ESP32 RX GPIO from ASRPRO TX, or -1 when unused"
    depends on ORNAMENT_ASRPRO_DONE_NOTIFY
    default -1

config ORNAMENT_ASRPRO_DONE_TRIGGER
    string "ASRPRO done trigger string"
    depends on ORNAMENT_ASRPRO_DONE_NOTIFY
    default "codex_done"
    help
        ASRPRO should match this exact serial string and play the user's
        selected audio file.

config ORNAMENT_ASRPRO_DONE_SUFFIX
    string "ASRPRO done trigger suffix"
    depends on ORNAMENT_ASRPRO_DONE_NOTIFY
    default ""
    help
        Optional suffix sent after the trigger. Leave empty for exact-string
        matching in ASRPRO. Use a line ending only if the ASRPRO project also
        matches that line ending.

config ORNAMENT_ASRPRO_TX_WAIT_MS
    int "ASRPRO UART TX wait in milliseconds"
    depends on ORNAMENT_ASRPRO_DONE_NOTIFY
    default 100
    range 10 2000

endmenu

config ORNAMENT_AUDIO_ENABLED
    bool "Enable task done voice reminder"
    default y
    help
        Play the embedded task_done.pcm clip once when a new bridge done event is observed.

config ORNAMENT_AUDIO_PIN_BCLK
    int "MAX98357A I2S BCLK GPIO"
    default 4
    depends on ORNAMENT_AUDIO_ENABLED

config ORNAMENT_AUDIO_PIN_LRC
    int "MAX98357A I2S LRC/WS GPIO"
    default 5
    depends on ORNAMENT_AUDIO_ENABLED

config ORNAMENT_AUDIO_PIN_DIN
    int "MAX98357A I2S DIN GPIO"
    default 6
    depends on ORNAMENT_AUDIO_ENABLED

config ORNAMENT_AUDIO_VOLUME_PERCENT
    int "Task done voice volume percent"
    default 70
    range 0 100
    depends on ORNAMENT_AUDIO_ENABLED

config ORNAMENT_STANDBY_CLOCK_MS
    int "Switch to standby clock page after idle milliseconds"
    default 120000
    range 0 3600000
    help
        Set 0 to disable the dedicated standby clock page. Idle status switches to clock after this duration.

config ORNAMENT_DISPLAY_DRIVER
    string "Display driver variant"
    default "st77916_qspi"
    help
        Purchased screen is a 1.5 inch 360x360 ST77916 QSPI 16P round TFT.
        Use st77916_qspi by default.

config ORNAMENT_LCD_SPI_HOST
    int "LCD SPI host"
    default 2
    help
        SPI2_HOST is normally 1 and SPI3_HOST is normally 2 in ESP-IDF enum values.

config ORNAMENT_LCD_H_RES
    int "LCD horizontal resolution"
    default 360

config ORNAMENT_LCD_V_RES
    int "LCD vertical resolution"
    default 360

config ORNAMENT_LCD_PIXEL_CLOCK_HZ
    int "LCD pixel clock Hz"
    default 40000000

config ORNAMENT_LCD_PIN_SCLK
    int "LCD SCLK GPIO"
    default 12

config ORNAMENT_LCD_PIN_MOSI
    int "LCD IO0 GPIO for QSPI"
    default 11

config ORNAMENT_LCD_PIN_MISO
    int "LCD IO1 GPIO for QSPI"
    default 13

config ORNAMENT_LCD_PIN_D2
    int "LCD IO2 GPIO for QSPI"
    default 14

config ORNAMENT_LCD_PIN_D3
    int "LCD IO3 GPIO for QSPI"
    default 15

config ORNAMENT_LCD_PIN_CS
    int "LCD CS GPIO"
    default 10

config ORNAMENT_LCD_PIN_DC
    int "LCD DC GPIO for SPI"
    default -1
    help
        Not used by the purchased QSPI panel.

config ORNAMENT_LCD_PIN_RST
    int "LCD RST GPIO"
    default 8

config ORNAMENT_LCD_PIN_BL
    int "LCD backlight control GPIO"
    default 7

endmenu
